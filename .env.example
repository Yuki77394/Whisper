# ──────────────────────────────────────────────────────────────
#  WhisperX – Environment configuration template
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────

# ── Telegram API credentials (https://my.telegram.org) ──
API_ID=1234567
API_HASH=your_api_hash_here

# ── Bot token from @BotFather ──
BOT_TOKEN=8805430490:AAH8d11bmzR4b17xNB1It9T1dmCi0WdMGRc

# ── MongoDB connection string ──
#  Local:  mongodb://localhost:27017
#  Atlas:  mongodb+srv://user:pass@cluster0.xxxx.mongodb.net
MONGO_URI=mongodb+srv://borovi1367_db_user:boroboro77394@cluster0.0aeqsca.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=whisperx

# ── Log group (private admin supergroup) ──
#  Create a private supergroup, add the bot as admin, then
#  forward any message from that group to @userinfobot to
#  retrieve its -100xxxxxxxxxx chat id.
LOG_GROUP_ID=-1004407377658

# ── Owner / admin Telegram user IDs (comma separated) ──
OWNER_ID=924235973
ADMIN_IDS=924235973

# ── Optional public-facing links ──
SUPPORT_CHAT=@Addicted4Her
UPDATE_CHANNEL=@NoMoreFeelings

# ── Behaviour toggles ──
#  When true, the log group only receives metadata (no message text / captions).
METADATA_ONLY_LOGS=false

#  Default whisper expiry in seconds (0 = no expiry by default).
DEFAULT_EXPIRY_SECONDS=0

#  Inline result cache lifetime in seconds (Telegram-side cache).
INLINE_CACHE_SECONDS=300

#  Background cleanup worker interval (seconds).
CLEANUP_INTERVAL_SECONDS=300

#  Per-user inline query rate limit (queries per minute).
RATE_LIMIT_PER_MINUTE=60

#  Bot worker count (Pyrogram workers).
WORKERS=8

#  Maximum whisper message length stored in DB (text body).
MAX_WHISPER_LENGTH=4096
